# ============================================================
# Village Finance — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any real secrets.
# ============================================================

# --- Supabase (public — safe for browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- PostgreSQL / Prisma (server-only — NEVER expose via NEXT_PUBLIC_) ---
# Pooled connection for runtime queries
DATABASE_URL=
# Direct connection for prisma migrate commands
DIRECT_URL=

# --- Cloudinary (server-only) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=village-finance

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
